<?xml version="1.0" encoding="utf-8"?>
<!--
  Akış ve DLNA sunucuları yerel ağda düz HTTP kullanır (192.168.x.x, 10.x.x.x…).
  Android ağ güvenliği yapılandırması IP aralığı tanımlayamadığı için düz HTTP genel olarak açıktır;
  uzak (tünel) adresler zaten https'dir.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
